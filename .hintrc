{
  "extends": [
    "development"
  ],
  "hints": {
    "axe/language": [
      "default",
      {
        "html-has-lang": "off"
      }
    ],
    "meta-viewport": "off",
    "axe/name-role-value": [
      "default",
      {
        "button-name": "off"
      }
    ]
  },
  "browserslist": [
    "defaults",
    "not ie 11",
    "not and_chr <= 122",
    "not and_ff <= 123",
    "not chrome <= 122",
    "not edge <= 122",
    "not firefox <= 123",
    "not ios_saf <= 17.4",
    "not opera <= 108",
    "not safari <= 17.4",
    "not samsung <= 23"
  ]
}